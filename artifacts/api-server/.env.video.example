# Video and Live feature flags
# Keep disabled until Yuniko is ready to activate them.
VIDEO_ENABLED=false
LIVE_ENABLED=false
SFU_ENABLED=false
LIVE_RECORDING_ENABLED=false

# Supabase is Yuniko's infrastructure boundary.
# PostgreSQL is used through DATABASE_URL and media is stored in Supabase Storage.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# NEVER expose the service-role key to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_MEDIA_BUCKET=media

# Custom JWT session secret. Use a long random secret in production.
SESSION_SECRET=

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when frontend and API are served from the same origin.
CORS_ORIGINS=

# Optional public media base URL. Leave empty to use the Supabase Storage public URL.
MEDIA_PUBLIC_BASE_URL=

# Optional SFU endpoint. It has no effect while SFU_ENABLED=false.
LIVE_SFU_URL=

# P2 scaling switches — all disabled by default.
REDIS_ENABLED=false
REDIS_URL=
FEED_CACHE_ENABLED=false
MONITORING_ENABLED=false
EXTERNAL_ALERTS_ENABLED=false
EXTERNAL_ALERT_WEBHOOK=
MULTI_SERVER_ENABLED=false
