# Video and Live feature flags
# Keep disabled until Yuniko is ready to activate them.
VIDEO_ENABLED=false
LIVE_ENABLED=false
SFU_ENABLED=false
LIVE_RECORDING_ENABLED=false

# Supabase = Auth + PostgreSQL only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cloudflare R2 = images/audio/video object storage.
# Keep R2 credentials server-only; never expose the secret key to the browser.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=yuniko-media
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Optional SFU endpoint. It has no effect while SFU_ENABLED=false.
LIVE_SFU_URL=

# P2 scaling switches — all disabled by default.
REDIS_ENABLED=false
REDIS_URL=
FEED_CACHE_ENABLED=false
MONITORING_ENABLED=false
EXTERNAL_ALERTS_ENABLED=false
EXTERNAL_ALERT_WEBHOOK=
MULTI_SERVER_ENABLED=false
