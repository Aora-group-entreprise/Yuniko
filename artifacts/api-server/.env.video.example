# Video and Live feature flags
# Keep disabled until Yuniko is ready to activate them.
VIDEO_ENABLED=false
LIVE_ENABLED=false
SFU_ENABLED=false
LIVE_RECORDING_ENABLED=false

# Supabase Storage (server-only; never expose the service-role key to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# Optional public CDN/base URL for future adapters.
MEDIA_PUBLIC_BASE_URL=

# Optional SFU endpoint. It has no effect while SFU_ENABLED=false.
LIVE_SFU_URL=
