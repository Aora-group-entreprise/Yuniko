{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuniko-api",
  "main": "./artifacts/api-server/src/worker.ts",
  "compatibility_date": "2026-09-22",
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": "./artifacts/yuniko/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://pqjrmtkfgwoocbvmwbby.supabase.co"
  },
  "secrets": {
    "required": [
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "VAPID_SUBJECT"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SIGNAL",
        "class_name": "CallSignalRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "calls-ephemeral-v1",
      "new_sqlite_classes": ["CallSignalRoom"]
    }
  ]
}